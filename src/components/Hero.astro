---
import { profile } from "../data/profile";
import Socials from "./Socials.astro";
---

<section class="hero">
  <div class="hero-text">
    <h1>{profile.name}</h1>
    <p class="subtitle" set:html={profile.subtitleHtml} />
    <p class="meta muted">
      <span>📍 {profile.location}</span>
      <span>·</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <div class="hero-actions">
      <Socials />
      <a class="cv-download" href="/Seungmin_Park_CV.pdf" download>
        Download CV (PDF)
      </a>
    </div>
  </div>
  <div class="hero-photo">
    <img
      src={profile.image}
      alt={`Portrait of ${profile.name}`}
      width="220"
      height="220"
      loading="eager"
    />
  </div>
</section>

<style>
  .hero {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-top: 2.5rem;
  }
  .hero-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin: 0.5rem 0 0.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cv-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cv-download:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    text-decoration: none;
  }
  .hero-photo {
    flex: 0 0 auto;
  }
  .hero-photo img {
    width: 220px;
    height: 220px;
    border-radius: 16px;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  @media (max-width: 560px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.25rem;
      margin-top: 1.75rem;
    }
    .hero-photo img {
      width: 160px;
      height: 160px;
    }
  }
  @media (max-width: 360px) {
    .cv-download {
      flex: 1 1 100%;
    }
  }
</style>
