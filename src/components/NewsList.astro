---
import { news } from "../data/news";
interface Props {
  limit?: number;
  scrollable?: boolean;
}
const { limit, scrollable = false } = Astro.props;
const items = [...news].sort((a, b) => (a.date < b.date ? 1 : -1));
const shown = limit ? items.slice(0, limit) : items;
---

<ul class:list={["news", { scrollable }]}>
  {
    shown.map((n) => (
      <li class="news-item">
        <span class="news-date muted">{n.display}</span>
        <span class="news-text" set:html={n.html} />
      </li>
    ))
  }
</ul>

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .news.scrollable {
    max-height: 16rem;
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .news-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.93rem;
  }
  .news-item:last-child {
    border-bottom: none;
  }
  .news-date {
    font-size: 0.85rem;
    padding-top: 0.05rem;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .news-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
